    create  table
      "kalshi"."main"."fct_kalshi_features__dbt_tmp"
  
    as (
      WITH hourly_data AS (
    SELECT * FROM "kalshi"."main"."stg_weather"
),

forecast_data AS (
    SELECT * FROM "kalshi"."main"."stg_forecast"
),

noaa_data AS (
    SELECT * FROM "kalshi"."main"."stg_noaa"
),

morning_features AS (
    SELECT
        weather_date,
        temp_f AS morning_temp_11am,
        cloud_cover AS morning_cloud_cover_11am
    FROM hourly_data
    WHERE hour_of_day = 11
),

daily_forecast AS (
    SELECT
        forecast_date,
        MAX(forecast_temp_previous_day1) AS forecast_high_previous_day1
    FROM forecast_data
    GROUP BY forecast_date
)

SELECT
    n.weather_date,
    n.official_high_temp AS target_high_temp,
    m.morning_temp_11am,
    m.morning_cloud_cover_11am,
    LAG(n.official_high_temp) OVER (ORDER BY n.weather_date) AS yesterday_high_temp,
    f.forecast_high_previous_day1
FROM noaa_data n
JOIN morning_features m
    ON n.weather_date = m.weather_date
JOIN daily_forecast f
    ON n.weather_date = f.forecast_date
ORDER BY n.weather_date DESC
    );
  
  
