    create  table
      "bike"."main"."stg_citibike__dbt_tmp"
  
    as (
      WITH raw_trips AS (
    SELECT
        date_trunc('hour', CAST(started_at AS TIMESTAMP)) AS trip_hour,
        rideable_type,
        member_casual,
        epoch(CAST(ended_at AS TIMESTAMP) - CAST(started_at AS TIMESTAMP)) / 60.0 AS duration_minutes
    FROM '../data/raw_citibike_*.parquet'
    WHERE started_at IS NOT NULL
      AND ended_at IS NOT NULL
)

SELECT
    trip_hour,
    COUNT(*) AS total_rides,
    COUNT(CASE WHEN member_casual = 'member' THEN 1 END) AS member_rides,
    COUNT(CASE WHEN member_casual = 'casual' THEN 1 END) AS casual_rides,
    COUNT(CASE WHEN rideable_type = 'electric_bike' THEN 1 END) AS electric_rides,
    COUNT(CASE WHEN rideable_type = 'classic_bike' THEN 1 END) AS classic_rides,
    ROUND(AVG(duration_minutes), 2) AS avg_duration_minutes
FROM raw_trips
-- Filter out zero/negative durations or GPS glitches > 24 hours
WHERE duration_minutes > 1 AND duration_minutes < 1440
GROUP BY trip_hour
    );
  
  
