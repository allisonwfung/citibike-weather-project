[0m17:57:35.727290 [debug] [Thread-1 (]: On model.kalshi_pipeline.fct_kalshi_features: /* {"app": "dbt", "dbt_version": "1.10.4", "profile_name": "kalshi_pipeline", "target_name": "dev", "node_id": "model.kalshi_pipeline.fct_kalshi_features"} */

  
    
    

    create  table
      "kalshi"."main"."fct_kalshi_features__dbt_tmp"
  
    as (
      WITH hourly_data AS (
    SELECT * FROM "kalshi"."main"."stg_weather"
),

daily_high AS (
    -- The Kalshi settlement target: the day's maximum temperature
    SELECT
        weather_date,
        MAX(temp_f) AS target_high_temp
    FROM hourly_data
    GROUP BY weather_date
),

morning_features AS (
    -- The data available to you when placing a morning trade (11:00 AM)
    SELECT
        weather_date,
        temp_f AS morning_temp_11am,
        cloud_cover AS morning_cloud_cover_11am
    FROM hourly_data
    WHERE hour_of_day = 11
)

SELECT
    d.weather_date,
    d.target_high_temp,
    m.morning_temp_11am,
    m.morning_cloud_cover_11am,
    LAG(d.target_high_temp) OVER (ORDER BY d.weather_date) AS yesterday_high_temp
FROM daily_high d
JOIN morning_features m
    ON d.weather_date = m.weather_date
ORDER BY d.weather_date DESC
    );
  
  
