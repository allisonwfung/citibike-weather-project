  AND ended_at IS NOT NULL
  AND (epoch(CAST(ended_at AS TIMESTAMP) - CAST(started_at AS TIMESTAMP)) / 60.0) > 1 
  AND (epoch(CAST(ended_at AS TIMESTAMP) - CAST(started_at AS TIMESTAMP)) / 60.0) < 1440
    );
  
  
