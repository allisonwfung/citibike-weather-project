      "bike"."main"."stg_citibike__dbt_tmp"
  
    as (
      SELECT
    CAST(started_at AS TIMESTAMP) AS started_at,
    CAST(ended_at AS TIMESTAMP) AS ended_at,
    date_trunc('hour', CAST(started_at AS TIMESTAMP)) AS trip_hour,
    
    rideable_type,
    member_casual,
    
