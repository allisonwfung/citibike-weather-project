    create  table
      "kalshi"."main"."fct_kalshi_features__dbt_tmp"
  
    as (
      WITH hourly_data AS (
    SELECT * FROM "kalshi"."main"."stg_weather"
),

target_temp AS (
    -- The Kalshi settlement hour (e.g., 4:00 PM / Hour 16)
    SELECT
        weather_date,
        temp_f AS target_temp_4pm
    FROM hourly_data
    WHERE hour_of_day = 18
),

morning_features AS (
    -- The data available to you when placing a morning trade (11:00 AM)
    SELECT
        weather_date,
        temp_f AS morning_temp_11am,
        cloud_cover AS morning_cloud_cover_11am
    FROM hourly_data
    WHERE hour_of_day = 11
)

SELECT
    t.weather_date,
    t.target_temp_4pm,
    m.morning_temp_11am,
    m.morning_cloud_cover_11am,
    LAG(t.target_temp_4pm) OVER (ORDER BY t.weather_date) AS yesterday_4pm_temp
FROM target_temp t
JOIN morning_features m 
    ON t.weather_date = m.weather_date
ORDER BY t.weather_date DESC
    );
  
  
