    create  table
      "kalshi"."main"."fct_kalshi_features__dbt_tmp"
  
    as (
      WITH hourly_data AS (
    SELECT * FROM "kalshi"."main"."stg_weather"
),

forecast_data AS (
    SELECT * FROM "kalshi"."main"."stg_forecast"
),

daily_high AS (
    SELECT
        weather_date,
        MAX(temp_f) AS target_high_temp
    FROM hourly_data
    GROUP BY weather_date
),

morning_features AS (
    SELECT
        weather_date,
        temp_f AS morning_temp_11am,
        cloud_cover AS morning_cloud_cover_11am,
        humidity AS morning_humidity_11am
    FROM hourly_data
    WHERE hour_of_day = 11
),

daily_forecast AS (
    -- What GFS predicted the day's high would be, 24hrs in advance
    SELECT
        forecast_date,
        MAX(forecast_temp_previous_day1) AS forecast_high_previous_day1
    FROM forecast_data
    GROUP BY forecast_date
)

SELECT
    d.weather_date,
    d.target_high_temp,
    m.morning_temp_11am,
    m.morning_cloud_cover_11am,
     m.morning_humidity_11am,
    LAG(d.target_high_temp) OVER (ORDER BY d.weather_date) AS yesterday_high_temp,
    f.forecast_high_previous_day1
FROM daily_high d
JOIN morning_features m
    ON d.weather_date = m.weather_date
JOIN daily_forecast f
    ON d.weather_date = f.forecast_date
ORDER BY d.weather_date DESC
    );
  
  
